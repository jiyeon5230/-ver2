function enter(i){
  if(i>=state.unlocked){toast("선생님이 차시를 열어 주시면 시작할 수 있어요.");return}
  current=i;step=state.done[i]?0:state.missions[i];
  rotation=-.55;zoom=1;tilt=.8;
  if(step>=3)reflection();else renderMission();
}
