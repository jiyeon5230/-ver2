function largeMap(){
  const t=lessons[current][step];
  modal("지도 크게 보기",t.country?countryMap():miniMap());
}
function observe(i){
  chosen=i;seen.add(i);
  $("observation").textContent=points[current][i].text;
  document.querySelectorAll(".point-buttons button").forEach((b,j)=>b.classList.toggle("active",j===i));
  highlightMap();draw();
  const t=lessons[current][step];
  if(t.type==="observe"){
    const count=t.need.filter(n=>seen.has(n)).length;
    $("observeProgress").textContent=`관찰 완료: ${count} / ${t.need.length}`;
  }
}
function highlightMap(){
  document.querySelectorAll(".map-point").forEach(g=>g.classList.toggle("selected",Number(g.dataset.point)===chosen));
}
function mapPick(i){
  observe(i);
  if(lessons[current][step].type==="map"){
    if(i===lessons[current][step].answer)completeMission(lessons[current][step].success);
    else feedback("지형에서 찾은 곳과 지도 속 위치를 다시 비교해 보자. "+lessons[current][step].hint,true);
  }
}
function feedback(message,wrong=false){
  $("feedback").textContent=message;$("feedback").className="feedback"+(wrong?" wrong":"");
}
function answer(i){
  const t=lessons[current][step];
  if(i===t.answer)completeMission(t.success);
  else feedback("조금 더 살펴볼까? "+t.hint,true);
}
function checkObservation(){
  const t=lessons[current][step];
  if(t.need.every(i=>seen.has(i)))completeMission("관찰할 지점을 모두 살펴봤어! 서로 다른 특징을 기억하며 다음 활동으로 가 보자.");
  else feedback("아직 살펴보지 않은 관찰 지점이 있어. 위쪽의 관찰 버튼을 하나씩 눌러 보자.",true);
}
function completeMission(message){
  state.missions[current]=Math.max(state.missions[current],step+1);save();
  feedback("✓ "+message);$("next").hidden=false;playSound();
}
function nextMission(){
  if($("next").hidden)return;
  step++;if(step>=3)reflection();else renderMission();
}
function hint(){feedback("💡 "+lessons[current][step].hint)}
function reflection(){
  const prompt=current===3?"내가 할 수 있는 독도 지키기 노력 한 가지와 그 이유를 적어 주세요.":
    current===2?"독도의 위치와 관찰한 자연환경을 담아 소개 카드를 완성해 주세요.":
    "무엇을 관찰했나요? 관찰한 특징과 지도에서 발견한 내용을 연결해 적어 주세요.";
  $("app").innerHTML=`<section class="card" style="max-width:850px;margin:auto">
  <span class="pill">발견 내용 정리</span><h1 style="margin-top:15px">${titles[current]} 기록</h1>
  ${guide(prompt)}
  <label for="reflection">나의 발견과 생각</label>
  <textarea id="reflection" maxlength="1200" placeholder="${current===3?"나는 …을 실천하겠습니다. 왜냐하면 …":"나는 …을 관찰했습니다. …을 보고 그렇게 생각했습니다."}">${esc(state.notes[current])}</textarea>
  <p><small>입력한 글은 자동으로 정답 판정하지 않아요. 관찰한 근거나 이유를 담았는지 스스로 확인해 보세요.</small></p>
  <label><input id="selfCheck" type="checkbox"> 관찰한 근거 또는 실천하는 이유를 적었어요.</label>
  <div class="row" style="margin-top:20px"><button onclick="step=0;renderMission()">다시 관찰하기</button><button class="primary" onclick="finish()">기록 저장하고 보상 받기 →</button></div>
  </section>`;
  $("reflection").addEventListener("input",()=>{state.notes[current]=$("reflection").value;save()});
}
function finish(){
  const text=$("reflection").value.trim();
  if(text.length<10){toast("관찰한 내용이나 이유를 조금 더 자세히 적어 주세요. (10자 이상)");return}
  if(!$("selfCheck").checked){toast("근거나 이유를 적었는지 확인하고 체크해 주세요.");return}
  const first=!state.done[current];
  state.notes[current]=text;state.done[current]=true;save();playSound();
  $("app").innerHTML=`<section class="card result"><span class="pill">탐험 완료 ✓</span>
  <div class="reward">${rewards[current]}</div><h1>${titles[current]} 완료!</h1>
