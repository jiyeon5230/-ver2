    '<rect width="320" height="280" fill="#c8d7ac"/><path d="M205 35L260 100L205 165L167 100Z" fill="#9eb784"/><path d="M120 0Q70 80 120 140T70 280" fill="none" stroke="#84bdcf" stroke-width="15"/>';
  return `<svg class="mini-map" viewBox="0 0 320 280" aria-label="입체 지형을 위에서 본 개념 지도">
  ${base}<text x="270" y="25" fill="#355c49" font-size="13">↑ 북</text>
  ${points[current].map((p,i)=>`<g class="map-point ${chosen===i?"selected":""}" data-point="${i}" role="button" tabindex="0" aria-label="${p.name} 선택"
