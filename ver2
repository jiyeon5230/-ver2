function selectDecoration(r){
  selectedDecoration=r;
  document.querySelectorAll("[data-decor]").forEach(b=>b.classList.toggle("selected",b.dataset.decor===r));
}
function place(i){
  if(state.placed[i])state.placed[i]="";
  else{
    if(!selectedDecoration){toast("먼저 장식을 선택해 주세요.");return}
    if(state.placed.includes(selectedDecoration)){toast("이미 배치한 장식이에요. 기존 장식을 눌러 회수한 뒤 옮겨 주세요.");return}
    state.placed[i]=selectedDecoration;
  }
  save();const keep=selectedDecoration;decorate();selectDecoration(keep);
}
function showTeacher(){
  modal("교사용 수업 설정",`<p>열어 둘 차시를 선택하세요. <b>이 설정은 현재 기기에만 적용</b>되며 학생 기기를 원격 제어하는 기능은 아닙니다.</p>
  <p><small>별도의 교사 인증이나 비밀번호 보호가 없는 시연용 설정입니다.</small></p>
  <label for="unlock">탐험 개방 범위</label>
  <select id="unlock">${titles.map((t,i)=>`<option value="${i+1}" ${state.unlocked===i+1?"selected":""}>${i+1}차시까지 열기</option>`).join("")}</select>
  <button onclick="applyUnlock()">적용</button>
  <div class="reading"><b>과정 평가 관찰 기준</b><p>① 지형 특징을 관찰하는가?<br>② 입체 지형과 지도를 연결하는가?<br>③ 피드백을 읽고 설명을 보완하는가?<br>④ 실천 방법과 이유를 표현하는가?</p></div>
  <p>공용 기기에서는 이전 학생의 기록이 남을 수 있어요. 기록을 내려받은 후 새 탐험가로 시작해 주세요.</p>
  <div class="row"><button onclick="exportRecord()">학습 기록 내려받기</button><button onclick="confirmReset()">새 탐험가 시작</button></div>`);
}
function applyUnlock(){
  state.unlocked=Number($("unlock").value);save();$("modal").close();showMap();toast(state.unlocked+"차시까지 열었어요.");
}
function exportRecord(){
  const data={탐험가:state.name,경험치:xp(),레벨:levelNames[level()],기록:titles.map((t,i)=>({차시:i+1,탐험:t,완료:state.done[i],완료미션:state.missions[i],발견내용:state.notes[i]}))};
  const blob=new Blob([JSON.stringify(data,null,2)],{type:"application/json;charset=utf-8"});
  const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download="terrain-learning-record.json";a.click();setTimeout(()=>URL.revokeObjectURL(a.href),1000);
}
function confirmReset(){
  modal("새 탐험가로 시작할까요?",`<p>현재 기기의 별명, 미션, 경험치, 발견 기록과 장식 배치가 초기화돼요. 필요한 기록은 먼저 내려받아 주세요.</p>
  <button onclick="exportRecord()">기록 내려받기</button>
  <button onclick="$('modal').close()">취소</button>
  <button class="primary" onclick="resetAll()">기록 초기화</button>`);
}
function resetAll(){
  const image=state.mascot;state=fresh();state.mascot=image;save();$("modal").close();startScreen();
}
$("mascotFile").addEventListener("change",e=>{
  const file=e.target.files[0];if(!file)return;
  if(file.size>2*1024*1024){toast("2MB 이하의 PNG·JPG·WebP 이미지를 선택해 주세요.");return}
  if(!["image/png","image/jpeg","image/webp"].includes(file.type)){toast("PNG·JPG·WebP 이미지를 선택해 주세요.");return}
  const reader=new FileReader();
  reader.onload=()=>{
    state.mascot=reader.result;save();
    document.querySelectorAll(".mascot,.mascot-emoji").forEach(el=>{
      const img=document.createElement("img");img.src=state.mascot;img.className="mascot";img.alt="마을 안내 캐릭터 큐티";el.replaceWith(img);
    });toast("큐티 이미지를 적용했어요.");
  };reader.readAsDataURL(file);e.target.value="";
});
function toggleSound(){
  sound=!sound;$("soundButton").textContent=sound?"소리 켜짐":"소리 꺼짐";if(sound)playSound();
}
function playSound(){
  if(!sound)return;
  try{
    audioContext=audioContext||new(window.AudioContext||window.webkitAudioContext)();
    audioContext.resume();
    const o=audioContext.createOscillator(),g=audioContext.createGain();
    o.type="sine";o.frequency.setValueAtTime(660,audioContext.currentTime);o.frequency.exponentialRampToValueAtTime(880,audioContext.currentTime+.12);
    g.gain.setValueAtTime(.04,audioContext.currentTime);g.gain.exponentialRampToValueAtTime(.001,audioContext.currentTime+.25);
    o.connect(g);g.connect(audioContext.destination);o.start();o.stop(audioContext.currentTime+.26);
  }catch(e){sound=false;$("soundButton").textContent="소리 꺼짐"}
}
/* 외부 라이브러리 없이 높이 격자를 투영하는 입체 지형 렌더러 */
function gauss(x,z,cx,cz,s){return Math.exp(-((x-cx)**2+(z-cz)**2)/s)}
function height(x,z){
  if(current===0){
    const riverX=-.4+.12*Math.sin(z*5);
    return .06+.7*gauss(x,z,.45,-.4,.13)+.32*gauss(x,z,.35,.3,.22)-.1*Math.exp(-((x-riverX)**2)/.006);
  }
  if(current===1){
    const coast=.12+.14*Math.sin(x*9);
    if(z>coast)return -.035;
    return .08+.24*gauss(x,z,.6,-.1,.12)+.12*gauss(x,z,-.6,-.4,.3);
  }
  return -.04+.66*gauss(x,z,-.32,.08,.035)+.46*gauss(x,z,.38,.17,.047);
}
function color(x,z,h){
  if(current===0){
    if(Math.abs(x-(-.4+.12*Math.sin(z*5)))<.06)return "#88bec9";
    if(h>.48)return "#9fb08b";if(h>.22)return "#b2c397";return "#c9d8aa";
  }
  if(current===1){
    const coast=.12+.14*Math.sin(x*9);
    if(z>coast)return "#a5d0d6";
    if(Math.abs(z-coast)<.13&&Math.abs(x)<.4)return "#e6d3a7";
    if(x>.36&&h>.15)return "#b4b5a1";
    return "#bdcfa6";
  }
  return h<.005?"#a5d0d6":h>.3?"#a9aa98":"#c7c6ad";
}
function project(x,y,z,w,h){
  const xx=x*Math.cos(rotation)-z*Math.sin(rotation);
  const zz=x*Math.sin(rotation)+z*Math.cos(rotation);
  const scale=Math.min(w*.37,h*.59)*zoom;
  return {x:w/2+xx*scale,y:h*.55+(zz*Math.sin(tilt)-y*Math.cos(tilt))*scale,depth:zz*Math.cos(tilt)+y*Math.sin(tilt)};
}
function initCanvas(){
  const c=$("terrain");
  c.addEventListener("pointerdown",e=>{drag={x:e.clientX,y:e.clientY,moved:false};c.setPointerCapture(e.pointerId)});
  c.addEventListener("pointermove",e=>{
    if(!drag)return;const dx=e.clientX-drag.x,dy=e.clientY-drag.y;
    if(Math.abs(dx)+Math.abs(dy)>2)drag.moved=true;
    rotation+=dx*.009;tilt=Math.max(.35,Math.min(1.2,tilt+dy*.005));drag.x=e.clientX;drag.y=e.clientY;draw();
  });
  c.addEventListener("pointerup",e=>{
    if(drag&&!drag.moved){
      const r=c.getBoundingClientRect(),x=e.clientX-r.left,y=e.clientY-r.top;
      const hit=screenPoints.find(p=>Math.hypot(p.x-x,p.y-y)<25);if(hit)observe(hit.i);
    }drag=null;
  });
  c.addEventListener("pointercancel",()=>drag=null);
  c.addEventListener("wheel",e=>{e.preventDefault();zoomBy(e.deltaY>0?-.08:.08)},{passive:false});
  draw();
}
function rotateBy(v){rotation+=v;draw()}
function zoomBy(v){zoom=Math.max(.65,Math.min(1.65,zoom+v));draw()}
function resetView(){rotation=-.55;tilt=.8;zoom=1;draw()}
function draw(){
  const c=$("terrain");if(!c)return;
  const ctx=c.getContext("2d");if(!ctx)return;
  const w=c.clientWidth,h=c.clientHeight,dpr=Math.min(window.devicePixelRatio||1,2);
  c.width=w*dpr;c.height=h*dpr;ctx.scale(dpr,dpr);
  const bg=ctx.createLinearGradient(0,0,0,h);bg.addColorStop(0,"#e4efeb");bg.addColorStop(1,"#d2e5df");
  ctx.fillStyle=bg;ctx.fillRect(0,0,w,h);
  const cells=[],n=32;
  for(let z=0;z<n;z++)for(let x=0;x<n;x++){
    const x0=-1+x*2/n,z0=-1+z*2/n,s=2/n;
    const verts=[[x0,z0],[x0+s,z0],[x0+s,z0+s],[x0,z0+s]].map(([a,b])=>project(a,height(a,b),b,w,h));
    cells.push({verts,depth:verts.reduce((a,p)=>a+p.depth,0)/4,fill:color(x0+s/2,z0+s/2,height(x0+s/2,z0+s/2))});
  }
  cells.sort((a,b)=>a.depth-b.depth);
  cells.forEach(cell=>{
    ctx.beginPath();cell.verts.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.closePath();
    ctx.fillStyle=cell.fill;ctx.fill();ctx.strokeStyle=cell.fill;ctx.lineWidth=.6;ctx.stroke();
  });
  screenPoints=[];
  points[current].forEach((p,i)=>{
    const pos=project(p.x,Math.max(height(p.x,p.z),0)+.07,p.z,w,h);screenPoints.push({...pos,i});
    ctx.beginPath();ctx.arc(pos.x,pos.y,chosen===i?19:15,0,Math.PI*2);
    ctx.fillStyle=chosen===i?"#ffd58a":"#fffdf4";ctx.fill();ctx.strokeStyle=chosen===i?"#c58535":"#5f7f6a";ctx.lineWidth=3;ctx.stroke();
    ctx.fillStyle="#335341";ctx.font="bold 14px sans-serif";ctx.textAlign="center";ctx.fillText(String(i+1),pos.x,pos.y+5);
  });
  ctx.fillStyle="#557567";ctx.font="12px sans-serif";ctx.textAlign="left";ctx.fillText("관찰용 입체 모형 · 실제 지형과 다름",15,24);
}
window.addEventListener("resize",draw);
goHome();
</script>
