<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>큐티의 지형 탐험 마을</title>
<style>
:root{--ink:#304b40;--green:#456d53;--mint:#e7efdf;--cream:#fffaf0;--line:#dce4d5;--orange:#dc8a48}
*{box-sizing:border-box}
body{margin:0;color:var(--ink);background:#f6f4e9;font-family:Arial,"Malgun Gothic",sans-serif;line-height:1.65}
button,input,textarea,select{font:inherit}
button{cursor:pointer;border:1px solid var(--line);border-radius:14px;padding:11px 17px;background:white;color:var(--ink);font-weight:700;transition:transform .15s,background .15s}
button:hover{background:#eff5e8;transform:translateY(-1px)}
button:focus-visible,input:focus-visible,textarea:focus-visible{outline:3px solid #df9c55;outline-offset:3px}
button:disabled{opacity:.45;cursor:not-allowed;transform:none}
button.primary{background:var(--green);color:white;border-color:var(--green)}
button.small{padding:6px 11px;font-size:13px}
input,textarea,select{border:1px solid #c7d6c4;background:white;border-radius:12px;padding:12px;color:var(--ink);max-width:100%}
textarea{width:100%;min-height:105px;resize:vertical}
h1,h2,h3,p{margin-top:0}h1{font-size:clamp(28px,4vw,46px);line-height:1.3}h2{line-height:1.4}small,.muted{color:#697c6c}
header{max-width:1250px;margin:auto;padding:20px 24px;display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}
.brand{font-weight:900;font-size:20px}.brand small{display:block;font-size:11px;letter-spacing:3px}
nav,.row{display:flex;gap:9px;align-items:center;flex-wrap:wrap}
main{max-width:1250px;margin:0 auto;padding:10px 24px 45px}
.card{background:#fffdf7;border:1px solid var(--line);border-radius:24px;padding:25px;box-shadow:0 8px 25px #52624408}
.pill{display:inline-block;border-radius:99px;background:#edf1e5;padding:5px 12px;font-size:12px;font-weight:700}
.hero{display:grid;grid-template-columns:1fr 1.25fr;gap:25px;align-items:center}
.hero-copy{padding:30px 15px}
.scene{height:390px;position:relative;background:linear-gradient(#dbeef0 65%,#d2e4da);border-radius:25px;overflow:hidden}
.scene svg{width:100%;height:100%}
.village-button{position:absolute;background:#fffdf2ed;box-shadow:0 5px 12px #40563b18}
.village-button.board{left:12%;top:42%}.village-button.book{right:9%;top:42%}.village-button.decorate{left:38%;bottom:7%}
.guide{display:flex;gap:15px;align-items:center;background:#fff8e8;border:1px solid #f1e1c0;border-radius:18px;padding:16px;margin:18px 0}
.mascot{width:76px;height:91px;object-fit:contain;flex:none}.mascot-emoji{font-size:54px;flex:none}
.guide p{margin:0}
.dashboard{display:grid;grid-template-columns:1fr 320px;gap:20px}
.progress{height:10px;border-radius:20px;background:#e7eadf;overflow:hidden;margin:12px 0}
.progress span{display:block;height:100%;background:#87ac75;transition:width .4s}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:15px}
.expedition{text-align:left;display:block;width:100%;padding:23px;border-radius:20px;background:#fffdf7}
.expedition .icon{font-size:34px;display:block;margin-bottom:10px}
.expedition h3{margin:8px 0}
.map-layout{display:grid;grid-template-columns:.9fr 1.1fr;gap:25px}
.country{width:100%;height:440px;background:#e3f0f0;border-radius:20px}
.explore-grid{display:grid;grid-template-columns:minmax(0,1fr) 330px;gap:20px}
.stage{position:relative;background:#e7f1ec;border-radius:23px;overflow:hidden;border:1px solid var(--line)}
#terrain{width:100%;height:440px;display:block;touch-action:none;cursor:grab}
.stage-tools{padding:10px;display:flex;gap:6px;flex-wrap:wrap;background:#f8fbf4}
.caption{font-size:12px;padding:8px 14px;background:#f8fbf4;color:#687d6d}
.point-buttons{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.point-buttons button.active{background:#fae6bd;border-color:#d69b4f}
.mini-map{width:100%;height:240px;background:#e2eeee;border-radius:15px}
.map-point{cursor:pointer;outline:none}.map-point:hover circle,.map-point:focus circle{stroke:#b16c27;stroke-width:5}
.map-point.selected circle{fill:#ffcc7d;stroke:#c27c34;stroke-width:4}
.map-point text{font-weight:bold;fill:#244e3d;font-size:13px;pointer-events:none}
.mission{margin-top:20px}
.options{display:grid;gap:10px;margin:15px 0}
.options button{text-align:left;font-weight:500}
.feedback{padding:12px 16px;background:#eef3e5;border-radius:13px;margin:12px 0}
.feedback.wrong{background:#fff0da}
.feedback:empty{display:none}
.steps{display:flex;gap:8px;margin:15px 0}.steps span{height:7px;flex:1;background:#e2e8db;border-radius:10px}.steps .done{background:#91ae79}
.reward{font-size:72px;margin:20px 0;text-align:center}
.result{text-align:center;max-width:760px;margin:auto}
.decor-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;background:#e5eed9;border-radius:18px;padding:18px;margin:16px 0}
.decor-grid button{min-height:85px;font-size:30px;background:#f3f8ea}
.inventory button.selected{outline:3px solid #d7a46c}
.reading{background:#f1f4e9;padding:17px;border-radius:15px;margin:15px 0}
.reading p:last-child{margin-bottom:0}
.note-card{margin:15px 0}.note-card h3{margin-bottom:8px}
dialog{border:1px solid var(--line);border-radius:23px;max-width:760px;width:calc(100% - 32px);padding:25px;background:#fffdf6;color:var(--ink)}
dialog::backdrop{background:#24433270}
.dialog-head{display:flex;justify-content:space-between;align-items:center;gap:15px}
footer{text-align:center;font-size:12px;color:#72816f;padding:20px}
.toast{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#304f3f;color:white;padding:12px 22px;border-radius:15px;z-index:100}
@media(max-width:850px){
.hero,.dashboard,.map-layout,.explore-grid{grid-template-columns:1fr}
header,main{padding-left:16px;padding-right:16px}
.hero-copy{padding:15px 5px}.scene{height:330px}
#terrain{height:350px}.country{height:340px}
}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header>
  <div class="brand">🌿 큐티의 지형 탐험 마을<small>MY LITTLE TERRAIN VILLAGE</small></div>
  <nav aria-label="주요 메뉴">
    <button class="small" onclick="goHome()">나의 마을</button>
    <button class="small" onclick="showBook()">탐험 도감</button>
    <button class="small" onclick="document.getElementById('mascotFile').click()">큐티 이미지</button>
    <button class="small" onclick="showTeacher()">교사용</button>
    <button class="small" id="soundButton" onclick="toggleSound()">소리 꺼짐</button>
  </nav>
</header>
<main id="app"></main>
<footer>지형은 특징을 비교하기 위한 학습 모형입니다. 실제 지형의 모양·높이·거리·축척과 다릅니다.</footer>
<input id="mascotFile" type="file" accept="image/png,image/jpeg,image/webp" hidden>
<dialog id="modal"><div id="modalContent"></div></dialog>
<div id="toast" class="toast" role="status" hidden></div>
<script>
"use strict";
const $=id=>document.getElementById(id);
const KEY="cutie-terrain-village-v1";
const fresh=()=>({
  name:"",avatar:"🌱",unlocked:1,missions:[0,0,0,0],
  notes:["","","",""],done:[false,false,false,false],
  placed:Array(12).fill(""),mascot:""
});
let state=fresh(),storageOK=true;
try{
  const saved=JSON.parse(localStorage.getItem(KEY)||"null");
  if(saved&&Array.isArray(saved.done)&&saved.done.length===4&&
     Array.isArray(saved.missions)&&saved.missions.length===4){
    state={...state,...saved};
    state.unlocked=Math.min(4,Math.max(1,Number(state.unlocked)||1));
    state.missions=state.missions.map(n=>Math.min(3,Math.max(0,Number(n)||0)));
  }
}catch(e){storageOK=false}
let current=0,step=0,seen=new Set(),chosen=-1,selectedDecoration="";
let rotation=-.55,zoom=1,tilt=.8,drag=null,screenPoints=[];
let sound=false,audioContext=null,toastTimer;
const titles=["산과 강 탐험","해안 탐험","독도 탐험","독도 지킴이 탐험"];
const icons=["⛰️","🐚","🏝️","🛡️"];
const rewards=["🌳","🐚","🚩","🏛️"];
const rewardNames=["나무 장식","조개 장식","탐험 깃발","마을 기념 장식"];
const levelNames=["새싹 탐험가","산과 강 탐험가","바다 탐험가","독도 탐험가"];
const esc=s=>String(s??"").replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]));
function save(){
  try{localStorage.setItem(KEY,JSON.stringify(state))}
  catch(e){storageOK=false;toast("저장 공간을 사용할 수 없어요. 교사용 메뉴에서 기록을 내려받아 주세요.")}
}
function toast(message){
  $("toast").textContent=message;$("toast").hidden=false;
  clearTimeout(toastTimer);toastTimer=setTimeout(()=>$("toast").hidden=true,3500);
}
function mascot(){
  return state.mascot?`<img class="mascot" src="${esc(state.mascot)}" alt="마을 안내 캐릭터 큐티">`:
    `<span class="mascot-emoji" aria-label="안내 캐릭터">🦊</span>`;
}
function guide(message){return `<div class="guide">${mascot()}<p><b>큐티</b><br>${message}</p></div>`}
function xp(){return state.missions.reduce((a,b)=>a+b,0)*10+state.done.filter(Boolean).length*20}
function level(){let n=0;while(n<3&&state.done[n])n++;return n}
function modal(title,body){
  $("modalContent").innerHTML=`<div class="dialog-head"><h2>${title}</h2><button onclick="$('modal').close()" aria-label="닫기">✕</button></div>${body}`;
  if(!$("modal").open)$("modal").showModal();
}
function villageArt(){
  return `<svg viewBox="0 0 700 420" role="img" aria-label="작은 집과 나무가 있는 포근한 섬마을">
  <ellipse cx="130" cy="75" rx="63" ry="18" fill="#ffffffaa"/>
  <ellipse cx="550" cy="100" rx="75" ry="21" fill="#ffffffaa"/>
  <circle cx="565" cy="52" r="28" fill="#fff1be"/>
  <ellipse cx="350" cy="335" rx="286" ry="60" fill="#9fc9c5"/>
  <path d="M72 290 Q100 185 245 185 Q300 140 420 181 Q580 176 626 284 L614 327 Q350 416 90 330Z" fill="#b3c9a0"/>
  <ellipse cx="350" cy="285" rx="276" ry="90" fill="#dce7b6"/>
  <path d="M332 256 Q290 300 380 360" fill="none" stroke="#e9d5aa" stroke-width="44"/>
  <rect x="277" y="187" width="146" height="108" rx="10" fill="#fff5db"/>
  <path d="M254 194 L349 111 L447 194Z" fill="#b77954" stroke="#966449" stroke-width="6" stroke-linejoin="round"/>
  <rect x="334" y="238" width="37" height="57" rx="18" fill="#94b3a0"/>
  <rect x="292" y="216" width="25" height="28" rx="5" fill="#b9d7da"/>
  <rect x="389" y="216" width="25" height="28" rx="5" fill="#b9d7da"/>
  <path d="M179 250V300 M508 248V294 M222 188V236" stroke="#b19769" stroke-width="14"/>
  <g fill="#9fbc86"><circle cx="178" cy="228" r="36"/><circle cx="508" cy="223" r="38"/><circle cx="222" cy="172" r="30"/></g>
  <g fill="#f4d593"><circle cx="140" cy="320" r="5"/><circle cx="530" cy="318" r="5"/><circle cx="454" cy="335" r="5"/></g>
  ${state.placed.map((item,i)=>item?`<text x="${130+(i%4)*137}" y="${273+Math.floor(i/4)*30}" font-size="28">${item}</text>`:"").join("")}
  </svg>`;
}
function startScreen(){
  $("app").innerHTML=`<section class="hero card">
    <div class="hero-copy"><span class="pill">관찰하고 · 발견하고 · 함께 자라요</span>
    <h1 style="margin-top:20px">지형을 배우면,<br>나의 작은 마을이 자라요.</h1>
    <p class="muted">산과 강을 지나 푸른 바다와 독도까지.<br>큐티와 함께 첫 번째 탐험을 떠나 볼까요?</p>
    <label for="nickname">탐험가 별명</label><br>
    <input id="nickname" maxlength="15" placeholder="별명을 입력해 주세요" style="margin:8px 0 14px;width:100%">
    <label for="avatar">나의 탐험가</label>
    <select id="avatar"><option>🌱</option><option>🐻</option><option>🐰</option><option>🐱</option></select>
    <button class="primary" onclick="begin()">탐험 시작 →</button>
    <p><small>이 기기의 브라우저에 학습 기록을 저장해요.</small></p></div>
    <div class="scene">${villageArt()}</div>
  </section>${guide("정답을 바로 몰라도 괜찮아. 지형을 돌려 보고, 힌트를 읽으며 함께 찾아보자!")}`;
}
function begin(){
  const name=$("nickname").value.trim();
  if(!name){toast("탐험가 별명을 입력해 주세요.");$("nickname").focus();return}
  state.name=name;state.avatar=$("avatar").value;save();goHome();
}
function goHome(){
  if(!state.name){startScreen();return}
  const lv=level();
  $("app").innerHTML=`<div class="row" style="justify-content:space-between;margin:10px 0 20px">
    <div><span class="pill">나의 작은 마을</span><h2 style="margin:9px 0">${esc(state.avatar)} ${esc(state.name)}의 탐험 일기</h2></div>
    <button class="primary" onclick="showMap()">탐험 지도 열기 →</button></div>
    <section class="dashboard"><div>
    <div class="scene">${villageArt()}
      <button class="village-button board" onclick="showMap()">🪧 탐험 게시판</button>
      <button class="village-button book" onclick="showBook()">📖 탐험 도감</button>
      <button class="village-button decorate" onclick="decorate()">🌼 마을 꾸미기</button>
    </div>${guide("오늘은 어디로 떠나 볼까? 탐험 게시판을 누르면 열려 있는 탐험을 확인할 수 있어.")}
    </div><aside class="card">
    <span class="pill">Lv.${lv+1} ${levelNames[lv]}</span>
    <h2 style="margin-top:18px">차곡차곡 쌓이는 발견</h2>
    <p>전체 탐험 경험치 <b>${xp()} / 200 XP</b></p>
    <div class="progress"><span style="width:${xp()/2}%"></span></div>
    <p>탐험 완료 <b>${state.done.filter(Boolean).length} / 4</b></p>
    <hr style="border:0;border-top:1px solid var(--line);margin:22px 0">
    <p>내가 모은 마을 장식</p>
    <div style="font-size:34px">${rewards.filter((r,i)=>state.done[i]).join(" ")||"🌱"}</div>
    ${state.done[3]?'<p class="pill">🛡️ 독도 지킴이 배지 획득</p>':""}
    <p><small>힌트를 사용해도, 다시 도전해도 보상은 같아요.</small></p>
    ${!storageOK?'<p>현재 자동 저장을 사용할 수 없어요.</p>':""}
    </aside></section>`;
}
function countryMap(){
  return `<svg class="country" viewBox="0 0 400 450" role="img" aria-label="우리나라 위치를 간단히 표현한 탐험 안내도">
  <text x="24" y="35" fill="#456957" font-size="14">탐험 안내도 · 실제 축척 아님</text>
  <path d="M210 55 L235 80 L224 112 L242 144 L239 175 L263 211 L257 247 L282 270 L274 300 L249 316 L241 343 L210 347 L199 367 L179 354 L156 370 L135 356 L143 335 L125 321 L145 300 L140 275 L164 254 L156 227 L179 201 L165 180 L188 150 L179 124 L198 100Z"
   fill="#c4d6aa" stroke="#93af87" stroke-width="3"/>
  <path d="M223 130 Q210 200 250 270" fill="none" stroke="#91aa7b" stroke-width="13" stroke-linecap="round"/>
  <path d="M224 223 Q180 240 148 278" fill="none" stroke="#90beca" stroke-width="7"/>
  <ellipse cx="141" cy="406" rx="25" ry="10" fill="#c4d6aa"/>
  <circle cx="312" cy="237" r="5" fill="#91ad81"/><circle cx="357" cy="257" r="4" fill="#91ad81"/>
  <text x="290" y="224" font-size="12">울릉도</text><text x="342" y="280" font-size="12">독도</text>
  <text x="288" y="164" font-size="14" fill="#61838a">동해</text>
  <text x="58" y="245" font-size="14" fill="#61838a">황해</text>
  <text x="233" y="397" font-size="14" fill="#61838a">남해</text>
  <text x="221" y="65" font-size="17">↑ 북</text>
  </svg>`;
}
function showMap(){
  $("app").innerHTML=`<span class="pill">탐험 게시판</span><h1 style="margin-top:16px">오늘의 발견을 찾아서</h1>
  <div class="map-layout"><div>${countryMap()}</div><div class="grid">
  ${titles.map((title,i)=>`<button class="expedition" ${i>=state.unlocked?"disabled":""} onclick="enter(${i})">
  <span class="icon">${icons[i]}</span><span class="pill">${i+1}차시 · ${state.done[i]?"탐험 완료 ✓":i>=state.unlocked?"선생님이 열어 주세요":"탐험 가능"}</span>
  <h3>${title}</h3><small>${["높낮이와 물길을 관찰해요.","해안의 서로 다른 모습을 비교해요.","섬의 위치와 자연환경을 살펴봐요.","자료를 읽고 실천을 생각해요."][i]}</small></button>`).join("")}
  </div></div>${guide("완료한 탐험도 다시 할 수 있어. 다음 차시는 선생님이 교사용 메뉴에서 열어 주실 거야.")}`;
}
const points=[
  [
    {x:.45,z:-.4,name:"산봉우리",text:"주변보다 높이 솟은 곳이 산봉우리야. 봉우리에서 이어지는 높은 줄기도 살펴보자."},
    {x:-.4,z:.1,name:"하천",text:"파란 물길이 하천이야. 주변 땅의 높낮이와 물길이 이어지는 방향을 비교해 보자."},
    {x:-.65,z:.65,name:"낮은 땅",text:"산지와 비교하면 높이가 낮고 완만한 곳이야. 물길 주변의 모습을 함께 살펴보자."}
  ],
  [
    {x:-.6,z:-.2,name:"구불구불한 해안",text:"육지와 바다가 만나는 선이 여러 번 안팎으로 굽어 있어. 만과 곶이 나타나는 모습을 살펴보자."},
    {x:0,z:.32,name:"모래 해안",text:"물결을 따라 모래가 쌓인 해안이야. 모래 해안은 우리나라 여러 해안에서 볼 수 있어."},
    {x:.6,z:-.1,name:"바위 해안",text:"바위가 드러나 있고 경사가 급한 부분이 보여. 해안의 재료와 경사를 비교해 보자."}
  ],
  [
    {x:-.32,z:.08,name:"서도",text:"서도는 동도의 서쪽에 있어. 바위와 가파른 경사를 관찰해 보자."},
    {x:.38,z:.17,name:"동도",text:"동도는 서도의 동쪽에 있어. 두 섬 사이에는 바닷물이 있어."},
    {x:0,z:.65,name:"주변 바다",text:"독도는 동해에 있는 우리나라의 섬이야. 섬 주변의 바다도 자연환경을 이루는 중요한 부분이야."}
  ]
];
const lessons=[
  [
    {type:"observe",title:"높은 곳과 물길 찾기",prompt:"산봉우리와 하천 관찰 지점을 모두 눌러 보세요.",need:[0,1],hint:"주변보다 높게 솟은 곳과 파랗게 이어지는 물길을 비교해 보자."},
