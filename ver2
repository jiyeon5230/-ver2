  <circle cx="${160+p.x*115}" cy="${135+p.z*100}" r="17" fill="#fffaf0" stroke="#638775" stroke-width="2"/>
  <text x="${160+p.x*115}" y="${140+p.z*100}" text-anchor="middle">${i+1}</text>
